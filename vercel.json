{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "klarkanis.vercel.app" }],
      "destination": "https://klarkanis.cz/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "missing": [{ "type": "host", "value": "klarkanis.cz" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
